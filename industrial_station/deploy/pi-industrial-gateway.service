[Unit]
Description=SIMULATED industrial test gateway
After=network.target pi-industrial-simulator.service
Wants=pi-industrial-simulator.service

[Service]
Type=simple
User=eur
WorkingDirectory=/home/eur/industrial-lab
ExecStart=/home/eur/industrial-lab/.venv/bin/python -m industrial_station.gateway --host 0.0.0.0 --port 8091
Restart=on-failure
RestartSec=2
TimeoutStopSec=8
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/eur/industrial-lab/industrial_station/runtime
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
